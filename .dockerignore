# Контекст сборки образов из deploy/ — корень репозитория; образам нужны только
# backend/, shared/, web/ и файлы deploy/. Секреты (.env) в контекст не попадают.
.git
.github
.claude
**/.env
build
build-*
client
installer
dist
docs
web/node_modules
web/dist
web/e2e
web/playwright-report
web/test-results

# «Переправа» собирается в Dockerfile.web из исходников — зависимости и сборки не нужны
pereprava/**/node_modules
pereprava/**/dist
pereprava/legacy
pereprava/e2e
pereprava/test-results
pereprava/playwright-report

{
    "listeners": [
        {
            "address": "0.0.0.0",
            "port": 8080,
            "https": false
        }
    ],
    "db_clients": [
        {
            "rdbms": "sqlite3",
            "filename": "vicinity.db",
            "connection_number": 1,
            "name": "default"
        }
    ],
    "app": {
        "threads_num": 4,
        "client_max_body_size": "20M",
        "log_level": "DEBUG",
        "log_path": "./log",
        "log_file": "vicinity",
        "document_root": "./uploads/",
        "upload_path": ".",
        "locations": [
            {
                "uri_prefix": "/uploads/",
                "alias": "./",
                "allow_all": true,
                "is_recursive": true
            }
        ]
    },
    "custom_config": {
        "registration": {
            "mode": "open",
            "signups_per_ip_per_day": 0,
            "site_url": ""
        },
        "trusted_proxies": [],
        "rtc": {
            "stun": ["stun:stun.l.google.com:19302"],
            "turn": [],
            "turn_secret": ""
        }
    }
}

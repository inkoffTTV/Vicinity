# Caddy из профиля "https" (docker-compose.yml): HTTPS для DOMAIN из deploy/.env.
# Сертификат Let's Encrypt выпускается и продлевается сам (нужны свободные порты 80 и 443
# и A-запись домена на IP VPS); http:// перенаправляется на https://.
# WebSocket (/ws) и X-Forwarded-For reverse_proxy передаёт сам, таймаутов для WebSocket нет.

{$DOMAIN} {
	# Браузер ходит на этот домен только по HTTPS (без includeSubDomains — соседние поддомены не затрагиваются)
	header Strict-Transport-Security "max-age=31536000"

	reverse_proxy web:80
}

# Vicinity web — сборка фронтенда (Vite/React) и раздача через nginx.
# Контекст сборки = корень репозитория (см. docker-compose.yml).

# ───── build ─────
FROM node:22-alpine AS build
WORKDIR /web
COPY web/package.json web/package-lock.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# ───── «Переправа» (активность в звонке) ─────
FROM node:22-alpine AS pereprava
WORKDIR /src
COPY pereprava/package.json pereprava/package-lock.json ./
COPY pereprava/packages/shared/package.json packages/shared/
COPY pereprava/packages/client/package.json packages/client/
COPY pereprava/packages/server/package.json packages/server/
RUN npm ci --no-audit --no-fund
COPY pereprava/tsconfig.base.json ./
COPY pereprava/packages packages
RUN npm run build -w @pereprava/client

# ───── runtime ─────
FROM nginx:1.27-alpine
COPY deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=build /web/dist /usr/share/nginx/html
COPY --from=pereprava /src/packages/client/dist /usr/share/nginx/html/activities/pereprava
EXPOSE 80

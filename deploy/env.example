# Настройки docker compose для Vicinity. Скопируй в .env в этой же папке и заполни:
#   cd deploy && cp env.example .env && nano .env
# .env не попадает в git (он в .gitignore) — секрет TURN храни только там.
# Пошагово — DEPLOY-VPS.md.

# ── Обязательно ────────────────────────────────────────────────────────────────
# Публичный IP VPS (узнать: curl -4 ifconfig.me). Нужен TURN-серверу для звонков через NAT.
PUBLIC_IP=
# Общий секрет сервера и coturn для временных учёток TURN. Сгенерировать: openssl rand -hex 32
VICINITY_TURN_SECRET=

# ── Сайт: выбери один сценарий (DEPLOY-VPS.md, шаг 2) ─────────────────────────
# Впиши значения своего сценария в строки WEB_BIND, WEB_PORT, COMPOSE_PROFILES и DOMAIN ниже.
# Не добавляй эти строки второй раз: если ключ встречается дважды, действует последняя строка.
#
#                     Сценарий А            Сценарий Б                  Без домена
#                     (HTTPS через Caddy    (nginx/Caddy хоста,         (только попробовать: голос,
#                     из этого compose,     например у Telegram-бота,   звонки и уведомления в браузере
#                     порты 80/443          проксирует поддомен         без HTTPS не работают)
#                     свободны)             на 127.0.0.1:WEB_PORT)
#   WEB_BIND          127.0.0.1             127.0.0.1                   0.0.0.0
#   WEB_PORT          8081                  8081 (занят — другой,       80
#                                           и он же в конфиге прокси)
#   COMPOSE_PROFILES  https                 (пусто)                     (пусто)
#   DOMAIN            chat.example.com      (пусто)                     (пусто)
#
# Сейчас ниже — «без домена». Готовые конфиги прокси для сценария Б — deploy/host-proxy/.
# WEB_BIND — только IPv4-адрес (0.0.0.0 или 127.0.0.1).
WEB_BIND=0.0.0.0
WEB_PORT=80
# "https" включает сервис caddy (только сценарий А)
COMPOSE_PROFILES=
# Домен для сценария А; его A-запись должна указывать на PUBLIC_IP
DOMAIN=

# ── Прямой порт сервера для десктоп-клиентов ──────────────────────────────────
# Десктоп подключается к http://IP_VPS:8080 (8080 занят — другой порт, тогда и адрес с ним).
# Когда все перейдут на https://домен, закрой порт снаружи: BACKEND_BIND=127.0.0.1
# (ufw опубликованные порты Docker не закрывает).
BACKEND_BIND=0.0.0.0
BACKEND_PORT=8080

# ── Регистрация ───────────────────────────────────────────────────────────────
# Режим: email   — капча «я не робот» + код из письма (по умолчанию, если заполнен SMTP ниже);
#        captcha — только капча (по умолчанию без SMTP);
#        open    — без проверок (не рекомендуется: так создают сотни аккаунтов скриптом);
#        closed  — регистрация закрыта.
# Десктоп-клиенты регистрируются на сайте (кроме режима open), входят как обычно.
VICINITY_REGISTRATION=
# Сколько аккаунтов можно создать с одного IP за сутки (0 — без лимита). Пусто — 3.
VICINITY_SIGNUPS_PER_IP=
# Адрес сайта — для писем и подсказки в десктопе, например https://chat.example.com
VICINITY_SITE_URL=
# Почта для писем с кодом. Подойдёт обычный ящик:
#   Яндекс:  smtp.yandex.ru, порт 465, логин — адрес ящика, пароль — «пароль приложения»
#            (id.yandex.ru → Безопасность → Пароли приложений → Почта)
#   Mail.ru: smtp.mail.ru, порт 465, пароль для внешних приложений
#   Gmail:   smtp.gmail.com, порт 465, пароль приложения (нужна двухэтапная проверка)
# Порт 465 — TLS сразу, 587 — STARTTLS (SECURITY пусто — выбор по порту; явно: ssl или starttls).
VICINITY_SMTP_HOST=
VICINITY_SMTP_PORT=
VICINITY_SMTP_USER=
VICINITY_SMTP_PASSWORD=
# Адрес отправителя; пусто — тот же, что SMTP_USER
VICINITY_SMTP_FROM=
VICINITY_SMTP_SECURITY=

# ── Необязательно ─────────────────────────────────────────────────────────────
# Пустое значение — значение по умолчанию.
# TURN-адреса для клиентов через запятую. По умолчанию — coturn этого VPS по UDP и TCP:
#   turn:PUBLIC_IP:3478?transport=udp,turn:PUBLIC_IP:3478?transport=tcp
VICINITY_TURN_URLS=
# STUN-адреса через запятую. По умолчанию — stun:stun.l.google.com:19302 (deploy/config.docker.json).
VICINITY_STUN_URLS=
# Подсети прокси, от которых сервер берёт IP клиента из X-Real-IP, через запятую.
# По умолчанию — частные сети (в них работает nginx веб-контейнера).
VICINITY_TRUSTED_PROXIES=

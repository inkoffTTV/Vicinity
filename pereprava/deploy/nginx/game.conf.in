# Общая часть: клиент и прокси к игровому серверу (подключается из http/https)
root /usr/share/nginx/html;
index index.html;

# Без add_header в location — иначе пропадут заголовки безопасности уровня server.
# Файлы сборки с хэшем в имени — кэш надолго, index.html — всегда свежий
location /assets/ {
  expires max;
  try_files $uri =404;
}

location = /index.html {
  expires epoch;
}

location / {
  try_files $uri /index.html;
}

# WebSocket игры
location /ws {
  proxy_pass http://game:8787;
  proxy_http_version 1.1;
  proxy_set_header Upgrade $http_upgrade;
  proxy_set_header Connection "upgrade";
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_read_timeout 120s;
  proxy_send_timeout 120s;
}

location = /health {
  proxy_pass http://game:8787/health;
  access_log off;
}

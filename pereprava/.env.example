# Скопируйте в .env и поправьте под свой сервер: cp .env.example .env

# Домен игры (для HTTPS). Пока домена нет — оставьте «_», игра откроется по IP через HTTP
DOMAIN=_
# Публичный адрес игры: нужен для ссылок-приглашений и /health
PUBLIC_URL=http://localhost
# Сколько комнат одновременно (каждая — 2–4 игрока)
MAX_ROOMS=50
# Порты на хосте. Если 80/443 уже заняты другим сайтом — поставьте, например, 8080/8443
HTTP_PORT=80
HTTPS_PORT=443
